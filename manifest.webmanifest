{
  "name": "Klappe – Proben, Self-Tapes, Castings",
  "short_name": "Klappe",
  "description": "Texte lernen, mit Szenenpartner proben, Self-Tapes drehen, passende Castings finden.",
  "id": "./",
  "start_url": "./#start",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#101215",
  "theme_color": "#101215",
  "lang": "de",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "file", "accept": ["application/pdf", ".pdf", "text/plain", ".txt"] }]
    }
  },
  "shortcuts": [
    { "name": "Casting-Radar", "short_name": "Radar", "url": "./#radar", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Casting eintragen", "short_name": "Eintragen", "url": "./#castings", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
